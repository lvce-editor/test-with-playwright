{
  "name": "test-with-playwright-monorepo",
  "version": "0.0.0-dev",
  "description": "Utility package for creating e2e test for LVCE Editor extensions",
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "files": [
    "src"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "e2e": "npm run build && npm run e2e --workspaces --if-present",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check . && knip --no-config-hints",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  },
  "jest": {
    "testTimeout": 30000
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@lvce-editor/eslint-config": "^18.1.0",
    "@lvce-editor/eslint-plugin-regex": "^18.1.0",
    "@lvce-editor/eslint-plugin-tsconfig": "^18.1.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "knip": "^6.31.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
