{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["eslint.config.js"],
      "project": ["*.{js,ts}"]
    },
    "packages/build": {
      "entry": ["src/build.ts", "src/computeNodeModulesCacheKey.ts"],
      "project": ["src/**/*.{js,ts}"],
      "ignoreDependencies": ["@lvce-editor/test-worker"]
    },
    "packages/e2e": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/server": {
      "ignoreDependencies": ["@lvce-editor/server"]
    },
    "packages/test-with-playwright": {
      "entry": ["bin/*.js", "src/main.ts", "test/**/*.test.ts"],
      "project": ["bin/*.js", "src/**/*.ts", "test/**/*.ts"]
    },
    "packages/test-with-playwright-worker": {
      "entry": ["src/workerMain.ts", "src/browser/SvgScreenshot.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
